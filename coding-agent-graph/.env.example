# Copy to .env and fill the values. Never commit .env.
# Restart the server after changing anything here (it does not run with --reload).

# --- GitHub ---
# Token the server uses to read Issues, post comments and open PRs (GitHub API).
# Never passed to Pi. Empty: falls back to GH_TOKEN, then to `gh auth token` on this machine.
# In cloud mode the sandbox pushes with its own token from `sbx --cloud secret set github`.
GITHUB_TOKEN=
# true (default): every webhook must carry a valid X-Hub-Signature-256, otherwise 401.
# false / off / 0 / no: accept unsigned webhooks. Development only: anyone who knows the
# tunnel URL can then send commands as an authorized user. The server logs a warning on start.
WEBHOOK_VERIFY_SIGNATURE=true
# Shared secret for the webhook signature. Must equal the "Secret" field of the webhook in
# GitHub (Settings -> Webhooks). Required while WEBHOOK_VERIFY_SIGNATURE is on; with no value
# every webhook is refused (500). Kept out of Pi's environment and the sandbox.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
# Comma-separated GitHub logins allowed to send /agent commands and trigger review rounds.
# Everyone else is ignored.
AUTHORIZED_GITHUB_USERS=your-github-login

# --- Model ---
# OpenRouter key for Pi. In local mode it is passed only to the Pi process. In cloud mode
# it is stored with `sbx --cloud secret set-custom` instead and never enters the sandbox.
OPENROUTER_API_KEY=
# OpenRouter model id Pi plans and codes with.
OPENROUTER_MODEL=z-ai/glm-5.3

# --- Workflow ---
# When a plan waits for `/agent approve`:
#   true  - every plan waits (default).
#   auto  - only plans Pi rates complex, or longer than AUTO_APPROVE_MAX_STEPS, wait.
#   false - never; implementation starts right after planning.
# Clarifying questions always wait for an answer. `/agent start auto` skips approval for one run.
REQUIRE_PLAN_APPROVAL=auto
# In auto mode, a plan with more steps than this always waits, even if rated simple.
AUTO_APPROVE_MAX_STEPS=4

# --- Execution ---
# Where Pi runs and the checks happen:
#   cloud - a Docker Cloud Sandbox per run that clones, verifies and pushes itself.
#           Needs `sbx login` plus cloud secrets; see README "Running in the cloud".
#   local - Pi runs on this machine in a git worktree under AGENT_DATA_DIR.
EXECUTION_MODE=cloud
# Docker sbx CLI executable (name on PATH or full path). Cloud mode only.
SBX_COMMAND=sbx
# Sandbox image ("kit") each run starts from. Cloud mode only.
SANDBOX_KIT=docker.io/docker/sbx-kit-pi:latest
# How long a sandbox lives before it is stopped (not deleted). A stopped sandbox costs nothing
# and resumes on the next command. Cloud mode only.
SANDBOX_TTL=24h
# Comma-separated hosts the sandbox may reach in addition to the kit's own list.
# Everything else is blocked (deny-all). Cloud mode only.
SANDBOX_ALLOW_NETWORK=github.com,api.github.com,codeload.github.com,raw.githubusercontent.com,openrouter.ai

# --- Telegram (optional) ---
# Key events go to a forum group, one topic per issue. Leave either empty to disable;
# events are still stored in SQLite (python events.py).
# Bot token from @BotFather. The bot must be an admin of the group with "Manage topics".
TELEGRAM_BOT_TOKEN=
# Group ID, e.g. -1001234567890 (see README "Key events and Telegram").
TELEGRAM_CHAT_ID=

# --- Langfuse tracing (optional) ---
# Tracing is on only when both keys are set. Create them in your Langfuse project settings.
# Langfuse receives the graph state, including Issue text, plans and human decisions.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse server, e.g. https://us.cloud.langfuse.com or a self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Environment label attached to every trace (filterable in Langfuse).
LANGFUSE_TRACING_ENVIRONMENT=development
# false turns tracing off even when the keys are set.
LANGFUSE_TRACING_ENABLED=true

# --- Advanced (defaults shown) ---
# Git repository the agent works on. Empty: the parent of coding-agent-graph/.
AGENT_REPOSITORY_PATH=
# Folder inside the repository Pi may edit and where lint/build run.
TODO_APP_PATH=todo-app
# Branch that agent branches start from and PRs target.
AGENT_MAIN_BRANCH=main
# Local state: SQLite (checkpoints, queue, dashboard data), worktrees and Pi sessions.
# Not committed. Empty: coding-agent-graph/.agent-data.
AGENT_DATA_DIR=.agent-data
# Pi executable (name on PATH or full path). Local mode only.
PI_COMMAND=pi
# Hard limit for one Pi session (planning or implementation) before it is killed.
PI_TIMEOUT_SECONDS=900
# Implementation attempts per run when the checks fail, before the run is marked failed.
AGENT_MAX_ATTEMPTS=3
# Maximum number of webhook work items waiting in memory for the worker.
AGENT_QUEUE_SIZE=100
# Server log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# LangGraph: only load known types from checkpoints (safer deserialization). Keep true.
LANGGRAPH_STRICT_MSGPACK=true
