# Copy to .env and fill the values. Never commit .env.
# Optional when `gh auth login` is already configured on this machine.
GITHUB_TOKEN=
AUTHORIZED_GITHUB_USERS=your-github-login

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3

# Optional LangGraph tracing. Create the keys in your Langfuse project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true

# Defaults are shown below. AGENT_REPOSITORY_PATH defaults to the parent project directory.
AGENT_REPOSITORY_PATH=
TODO_APP_PATH=todo-app
AGENT_MAIN_BRANCH=main
AGENT_DATA_DIR=.agent-data
PI_COMMAND=pi
PI_TIMEOUT_SECONDS=900
AGENT_MAX_ATTEMPTS=3
# false = implement right after planning; `/agent start auto` does the same for one run.
REQUIRE_PLAN_APPROVAL=true
AGENT_QUEUE_SIZE=100
LOG_LEVEL=INFO
LANGGRAPH_STRICT_MSGPACK=true
