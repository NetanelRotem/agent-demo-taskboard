# Copy to .env and fill the values. Never commit .env.

# --- GitHub ---
# Optional when `gh auth login` is already configured on this machine.
GITHUB_TOKEN=
# Required: every webhook must be signed with it (same value in the GitHub webhook settings).
# Generate: python -c "import secrets; print(secrets.token_hex(32))". Kept out of Pi's environment.
GITHUB_WEBHOOK_SECRET=
AUTHORIZED_GITHUB_USERS=your-github-login

# --- Model ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3

# --- Workflow ---
# false = implement right after planning (clarifying questions still wait for an answer);
# `/agent start auto` does the same for one run.
REQUIRE_PLAN_APPROVAL=false

# --- Execution ---
# cloud = Pi runs in a Docker Cloud Sandbox that clones, verifies, and pushes itself.
#         Needs `sbx login` plus cloud secrets; see README "הרצה בענן".
# local = Pi runs on this machine in a git worktree.
EXECUTION_MODE=cloud
SBX_COMMAND=sbx
SANDBOX_KIT=docker.io/docker/sbx-kit-pi:latest
SANDBOX_TTL=24h
# Comma-separated hosts the sandbox may reach in addition to the kit's own list.
SANDBOX_ALLOW_NETWORK=github.com,api.github.com,codeload.github.com,raw.githubusercontent.com,openrouter.ai

# --- Telegram (optional) ---
# Key events go to a forum group, one topic per issue. Leave either empty to disable;
# events are still stored in SQLite (python events.py).
TELEGRAM_BOT_TOKEN=
# Group ID, e.g. -1001234567890 (see README "אירועי מפתח ו־Telegram").
TELEGRAM_CHAT_ID=

# --- Langfuse tracing (optional) ---
# Create the keys in your Langfuse project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true

# --- Advanced (defaults shown) ---
# AGENT_REPOSITORY_PATH defaults to the parent project directory.
AGENT_REPOSITORY_PATH=
TODO_APP_PATH=todo-app
AGENT_MAIN_BRANCH=main
AGENT_DATA_DIR=.agent-data
PI_COMMAND=pi
PI_TIMEOUT_SECONDS=900
AGENT_MAX_ATTEMPTS=3
AGENT_QUEUE_SIZE=100
LOG_LEVEL=INFO
LANGGRAPH_STRICT_MSGPACK=true
